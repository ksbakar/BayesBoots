library(survival)
head(lung)
ibrary(MASS)
lung$ph.karno_status <- cut(lung$ph.karno,
breaks = c(0, 70, 100),
labels = c("low", "high"))
cox_data <- na.omit(lung)
system.time({
fit_cox <- runBB(
data = cox_data,
model = "BB-Cox",
formula = survival::Surv(time, status) ~ age + sex +
ph.ecog + ph.karno_status + wt.loss,
prior_fn = prior_normal,
M = 100
)})
summary(fit_cox)
lung2 <- lung
lung2$status <- lung2$status - 1
lung2 <- lung2[!is.na(lung2$ph.karno),]
cox_data2 <- na.omit(lung2)
library(brms)
system.time({
fit_cox_brms <- brms::brm(time | cens(1 - status) ~ age + sex +
ph.ecog + ph.karno_status + wt.loss,
data = cox_data2, family = brmsfamily("cox"),
silent = 2, refresh = 0, cores = 4,
prior = prior(normal(0,1), class = b))})
summary(fit_cox_brms)
summary(fit_cox)
system.time({
fit_cox <- runBB(
data = cox_data,
model = "BB-Cox",
formula = survival::Surv(time, status) ~ age + sex +
ph.ecog +  wt.loss,
prior_fn = prior_normal
)}) # < 1 sec
system.time({
fit_cox_brms <- brms::brm(time | cens(1 - status) ~ age + sex +
ph.ecog + wt.loss,
data = cox_data2, family = brmsfamily("cox"),
silent = 2, refresh = 0, cores = 4,
prior = prior(normal(0,1), class = b))}) # > 1 minute
summary(fit_cox_brms)
summary(fit_cox)
