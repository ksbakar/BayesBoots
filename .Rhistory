plot.BayesBoots <- function(object,
type = NULL,
group_var = NULL,
...) {
# type can take: "hr", "or", "density", "baseline", "surv"
class_type <- intersect(c("BB-GLM", "BB-Cox", "BB-CRR", "BB-KM"), class(object))[1]
