weighted_hpd <- function(
x,
w,
prob = 0.95
) {
stopifnot(length(x) == length(w))
# Sort by x
ord <- order(x)
x <- x[ord]
w <- w[ord]
# Normalize weights
w <- w / sum(w)
# Cumulative weights
cw <- cumsum(w)
n <- length(x)
# Store candidate intervals
intervals <- data.frame(
lower = numeric(0),
upper = numeric(0),
width = numeric(0)
)
# For each possible lower bound
for (i in 1:n) {
# Need cumulative probability of prob
target <- cw[i] + prob
# Find smallest j such that mass >= prob
j <- which(cw >= target)[1]
if (!is.na(j)) {
intervals <- rbind(
intervals,
data.frame(
lower = x[i],
upper = x[j],
width = x[j] - x[i]
)
)
}
}
# Select shortest interval
hpd <- intervals[which.min(intervals$width), ]
return(
c(
lower = hpd$lower,
upper = hpd$upper
)
)
}
theta <- rnorm(100, mean=5, sd=1)
# Dirichlet weights
w <- rexp(100)
w <- w / sum(w)
weighted_hpd(
x = theta,
w = w,
prob = 0.95
)
weighted_quantile(x, w, c(0.025,0.975))
weighted_quantile <- function(
x,
w,
probs
) {
stopifnot(length(x) == length(w))
ord <- order(x)
x <- x[ord]
w <- w[ord]
w <- w / sum(w)
cw <- cumsum(w)
sapply(probs, function(p) {
x[which(cw >= p)[1]]
})
}
weighted_quantile(x, w, c(0.025,0.975))
theta <- rnorm(100, mean=5, sd=1)
# Dirichlet weights
w <- rexp(100)
w <- w / sum(w)
weighted_hpd(
x = theta,
w = w,
prob = 0.95
)
weighted_quantile(x=theta, w=w, probs=c(0.025,0.975))
weighted_quantile(x=theta, w=w, probs=c(0.025,0.5,0.975))
weighted_hpd <- function(
x,
w,
prob = 0.95
) {
stopifnot(length(x) == length(w))
# Sort by x
ord <- order(x)
x <- x[ord]
w <- w[ord]
# Normalize weights
w <- w / sum(w)
# Cumulative weights
cw <- cumsum(w)
n <- length(x)
lower <- numeric(0)
upper <- numeric(0)
width <- numeric(0)
for (i in seq_len(n)) {
start_prob <- ifelse(i == 1, 0, cw[i-1])
j <- which(cw >= start_prob + prob)[1]
if (!is.na(j)) {
lower <- c(lower, x[i])
upper <- c(upper, x[j])
width <- c(width, x[j] - x[i])
}
}
idx <- which.min(width)
# Median from weighted posterior
median <- weighted_quantile(
x = x,
w = w,
probs = 0.5
)
c(
lower = lower[idx],
median = median,
upper = upper[idx]
)
}
theta <- rnorm(100, mean=5, sd=1)
