)
}
)
######################################################
## Return object
######################################################
structure(
list(
summary = stratified_summary,
curves_data = curves,
diagnostics = tibble::tibble(
draw = seq_len(M_eff),
risk = gibbs$risk,
omega = gibbs$omega,
weight = w
),
prior_fn = omega_fn,
formula = formula
),
class = "BayesBoots"
)
}
