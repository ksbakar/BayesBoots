pr_fn <- function (beta, spike_var = 0.5, slab_var = 1, pi = 0.5)
{
dens <- pi * dnorm(beta, mean = 0, sd = sqrt(spike_var)) +
(1 - pi) * dnorm(beta, mean = 0, sd = sqrt(slab_var))
-sum(log(dens + 1e-12))
}
